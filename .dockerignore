# Git files
.git
.github
.gitignore
.gitattributes

# Environment files - CRITICAL: Prevent secrets from being copied into images
.env
.env.*
!.env.example
!.env.*.example

# Dependencies - Will be installed during build
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs - Will be generated during build
.next
dist
build
out

# Testing
coverage
.nyc_output
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
__tests__
test

# IDE files
.vscode
.idea
*.swp
*.swo
*~
.DS_Store

# Documentation
README.md
CHANGELOG.md
LICENSE
docs
*.md
!package.json

# Docker files - Don't copy Docker configs into the image
docker-compose*.yml
Dockerfile*
.dockerignore

# Logs
logs
*.log

# Temporary files
tmp
temp
*.tmp

# Uploads and user-generated content
uploads
backups
public/uploads

# Database files
*.db
*.sqlite
*.sqlite3
prisma/dev.db

# OS files
Thumbs.db
.DS_Store

# Editor backup files
*.bak
*.orig
*.rej

# Development scripts
scripts/dev-*
scripts/test-*

# Miscellaneous
.cache
.parcel-cache
.turbo
*.tsbuildinfo
