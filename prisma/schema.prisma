generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth.js Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Application User (Extended for Auth)
model AppUser {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  displayName   String // Kept for backward compatibility, sync with name
  passwordHash  String? // For credentials auth if needed

  // Profile customization
  profilePictureUrl String? // Custom uploaded profile picture
  profileColor      String? // User's preferred accent color

  // Password reset fields
  resetToken       String? // Hashed reset token
  resetTokenExpiry DateTime? // Token expiration timestamp

  // Account lockout fields (brute force protection)
  failedLoginAttempts Int       @default(0)
  lastFailedAttempt   DateTime?
  accountLockedUntil  DateTime?

  accounts Account[]
  sessions Session[]

  school          School?              @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  schoolId        String?
  teacher         Teacher?             @relation("TeacherAccount", fields: [teacherId], references: [id], onDelete: SetNull)
  teacherId       String?              @unique
  roleAssignments UserRoleAssignment[]

  // Parent and Student user links
  parentUser  ParentUser?
  studentUser StudentUser?

  // Behavior incidents issued by this user
  behaviorIncidents BehaviorIncident[]

  // Messages sent by this user
  messages Message[]

  // Notifications for this user
  notifications Notification[]

  // Announcements created by this user
  announcements Announcement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([email])
}

model RoleDefinition {
  id          String               @id @default(cuid())
  key         String               @unique
  name        String
  description String?
  priority    Int                  @default(0)
  assignments UserRoleAssignment[]
  permissions RolePermission[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model PermissionDefinition {
  id          String           @id @default(cuid())
  key         String           @unique
  resource    String
  action      String
  description String?
  grants      RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([resource, action])
}

model RolePermission {
  id           String               @id @default(cuid())
  role         RoleDefinition       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId       String
  permission   PermissionDefinition @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String
  createdAt    DateTime             @default(now())

  @@unique([roleId, permissionId])
}

model UserRoleAssignment {
  id            String         @id @default(cuid())
  user          AppUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  role          RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId        String
  scopeSchoolId String?
  scopeClassId  String?
  createdAt     DateTime       @default(now())

  @@index([userId, roleId])
}

model School {
  id        String  @id @default(cuid())
  name      String
  shortCode String? @unique

  // Extended school metadata
  emisNumber  String? // DBE EMIS number
  schoolType  String? // public, independent, special, remedial
  schoolPhase String? // primary, secondary, combined, intermediate
  province    String? // SA province code
  district    String? // Education district
  branding    Json?   // UI branding: logoUrl, primary, secondary, accent

  gradingConfig        GradingConfig?        @relation("SchoolGradingConfig", fields: [gradingConfigId], references: [id])
  gradingConfigId      String?               @unique
  classes              ClassGroup[]
  subjects             Subject[]
  curriculumTemplates  CurriculumTemplate[]
  teachers             Teacher[]
  gradeLevels          GradeLevel[]
  auditLogs            AuditLog[]
  learnerRegistrations LearnerRegistration[]
  users                AppUser[]
  timetables           Timetable[]
  teacherInvitations   TeacherInvitation[]

  // Parent and student invitations
  parentInvitations  ParentInvitation[]
  studentInvitations StudentInvitation[]

  // Behavior system
  behaviorIncidents BehaviorIncident[]
  behaviorPolicies  BehaviorPolicy[]
  behaviorTriggers  BehaviorThresholdTrigger[]

  // Communications
  messageThreads MessageThread[]
  notifications  Notification[]
  announcements  Announcement[]

  // Fees & Accounting
  bankDetails   Json?   // { bankName, accountNumber, branchCode, accountHolder, reference? }
  feeStructures FeeStructure[]
  invoices      Invoice[]
  ledgerEntries AccountLedger[]
  creditNotes   CreditNote[]

  // Homework & Events
  homework     Homework[]
  schoolEvents SchoolEvent[]

  // Subject configuration per grade
  gradeSubjectConfigs GradeSubjectConfig[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GradingConfig {
  id         String  @id @default(cuid())
  name       String
  phasesJson Json
  school     School? @relation("SchoolGradingConfig")
}

model Subject {
  id                 String                     @id @default(cuid())
  name               String
  code               String
  phase              String
  school             School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId           String
  classes            ClassGroup[]
  teacherAssignments ClassTeacherAssignment[]
  teacherSubjects    TeacherSubjectAssignment[]
  gradeConfigs       GradeSubjectConfig[]
}

model ClassGroup {
  id                   String                   @id @default(cuid())
  name                 String
  grade                Int // Grade R = 0, Grades 1-12 = 1-12. See lib/constants/grading.ts for phase mapping.
  year                 Int
  classType            ClassType                @default(Subject)
  subject              Subject?                 @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  subjectId            String?
  school               School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId             String
  curriculumTemplate   CurriculumTemplate?      @relation(fields: [curriculumTemplateId], references: [id], onDelete: SetNull)
  curriculumTemplateId String?
  gradeLevel           GradeLevel?              @relation(fields: [gradeLevelId], references: [id], onDelete: SetNull)
  gradeLevelId         String?
  primaryTeacher       Teacher?                 @relation("PrimaryClassTeacher", fields: [primaryTeacherId], references: [id], onDelete: SetNull)
  primaryTeacherId     String?
  students             Student[]
  assessmentPlans      AssessmentPlan[]
  learnerRegistrations LearnerRegistration[]
  teacherAssignments   ClassTeacherAssignment[]
  timetableSlots       TimetableSlot[]
  learnerComments      LearnerComment[]
  reportCards          ReportCard[]
  homework             Homework[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([schoolId])
  @@index([gradeLevelId])
}

model Student {
  id               String                @id @default(cuid())
  admissionNumber  String
  firstName        String
  lastName         String
  gender           String
  classGroup       ClassGroup            @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  classGroupId     String
  advisor          Teacher?              @relation("AdvisorTeacher", fields: [advisorTeacherId], references: [id], onDelete: SetNull)
  advisorTeacherId String?
  marks            Mark[]
  registrations    LearnerRegistration[]
  snapshots        MarkSnapshot[]
  parents          ParentContact[]
  comments         LearnerComment[]
  reportCards      ReportCard[]

  // Student user account link
  studentUser       StudentUser?
  studentInvitation StudentInvitation[]

  // Behavior tracking
  behaviorIncidents BehaviorIncident[]
  behaviorBalance   BehaviorBalance?
  behaviorTriggers  BehaviorThresholdTrigger[]

  // Fees & Accounting
  discounts     StudentDiscount[]
  invoices      Invoice[]
  ledgerEntries AccountLedger[]
  creditNotes   CreditNote[]

  // Homework
  homeworkSubmissions HomeworkSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Teacher {
  id                 String                     @id @default(cuid())
  firstName          String
  lastName           String
  email              String                     @unique
  phone              String?
  role               String                     @default("Teacher")
  bio                String?
  school             School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId           String
  primaryClasses     ClassGroup[]               @relation("PrimaryClassTeacher")
  classAssignments   ClassTeacherAssignment[]
  subjectAssignments TeacherSubjectAssignment[]
  advisees           Student[]                  @relation("AdvisorTeacher")
  account            AppUser?                   @relation("TeacherAccount")
  timetableSlots     TimetableSlot[]
  invitations        TeacherInvitation[]
  homework           Homework[]
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@index([schoolId])
}

model ClassTeacherAssignment {
  id           String     @id @default(cuid())
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  classGroupId String
  teacher      Teacher    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId    String
  role         String     @default("Support")
  subject      Subject?   @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  subjectId    String?
  createdAt    DateTime   @default(now())

  @@unique([classGroupId, teacherId])
}

enum ClassType {
  Subject
  Homeroom
}

model TeacherSubjectAssignment {
  id        String   @id @default(cuid())
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  teacherId String
  subject   Subject  @relation(fields: [subjectId], references: [id])
  subjectId String
  grade     Int?
  createdAt DateTime @default(now())
}

model ParentContact {
  id           String  @id @default(cuid())
  student      Student @relation(fields: [studentId], references: [id])
  studentId    String
  fullName     String
  relationship String
  email        String?
  phone        String?
  primary      Boolean @default(true)

  // Link to parent user account
  parentUser   ParentUser? @relation("ParentUserContacts", fields: [parentUserId], references: [id])
  parentUserId String?

  // Invitation for account creation
  invitation ParentInvitation[]

  // Invoices associated with this parent
  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GradeLevel {
  id             String               @id @default(cuid())
  name           String
  order          Int
  school         School               @relation(fields: [schoolId], references: [id])
  schoolId       String
  classes        ClassGroup[]
  subjectConfigs GradeSubjectConfig[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

// Configuration for which subjects are offered per grade level
model GradeSubjectConfig {
  id           String     @id @default(cuid())
  school       School     @relation(fields: [schoolId], references: [id])
  schoolId     String
  gradeLevel   GradeLevel @relation(fields: [gradeLevelId], references: [id], onDelete: Cascade)
  gradeLevelId String
  subject      Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId    String
  isCompulsory Boolean    @default(true)
  createdAt    DateTime   @default(now())

  @@unique([gradeLevelId, subjectId])
  @@index([schoolId])
}

model AssessmentPlan {
  id                String               @id @default(cuid())
  name              String
  year              Int
  termCount         Int
  status            String
  submittedAt       DateTime?
  approvedAt        DateTime?
  lockedAt          DateTime?
  submittedByRole   String?
  approvedByRole    String?
  termWeights       Json?
  template          CurriculumTemplate?  @relation(fields: [templateId], references: [id])
  templateId        String?
  classGroup        ClassGroup           @relation(fields: [classGroupId], references: [id])
  classGroupId      String
  assessments       Assessment[]
  moderationThreads ModerationThread[]
  documents         AssessmentDocument[]
  snapshots         MarkSnapshot[]
  timetableSlots    TimetableSlot[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model Assessment {
  id                 String               @id @default(cuid())
  assessmentPlan     AssessmentPlan       @relation(fields: [assessmentPlanId], references: [id])
  assessmentPlanId   String
  taskName           String
  term               String
  totalMark          Int
  rawWeight          Float
  weightPercent      Float
  sequence           Int
  type               String?
  status             String
  dueDate            DateTime?
  isPatComponent     Boolean              @default(false)
  termWeightOverride Float?
  category           String?
  marks              Mark[]
  moderationThreads  ModerationThread[]
  documents          AssessmentDocument[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model Mark {
  id           String     @id @default(cuid())
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  assessmentId String
  student      Student    @relation(fields: [studentId], references: [id])
  studentId    String
  rawMark      Float?
  isAbsent     Boolean    @default(false)
  absenceCode  String?
  status       String     @default("Draft")
  comment      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([assessmentId, studentId])
}

model ModerationThread {
  id                String               @id @default(cuid())
  title             String?
  kind              String? // plan | assessment | moderation
  assessmentPlan    AssessmentPlan?      @relation(fields: [assessmentPlanId], references: [id])
  assessmentPlanId  String?
  assessment        Assessment?          @relation(fields: [assessmentId], references: [id])
  assessmentId      String?
  status            String
  createdByRole     String
  resolvedAt        DateTime?
  resolvedBy        String?
  resolutionSummary String?
  escalatedAt       DateTime?
  escalatedBy       String?
  escalationReason  String?
  comments          ModerationComment[]
  documents         AssessmentDocument[]
  events            ModerationThreadEvent[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model ModerationComment {
  id            String           @id @default(cuid())
  thread        ModerationThread @relation(fields: [threadId], references: [id])
  threadId      String
  authorRole    String
  message       String
  attachmentUrl String?
  createdAt     DateTime         @default(now())
}

model ModerationThreadEvent {
  id         String           @id @default(cuid())
  thread     ModerationThread @relation(fields: [threadId], references: [id])
  threadId   String
  eventType  String // status_change, escalation, resolution, comment, reopen
  fromStatus String?
  toStatus   String?
  actorRole  String
  actorId    String
  note       String?
  createdAt  DateTime         @default(now())

  @@index([threadId])
}

model CurriculumTemplate {
  id                  String               @id @default(cuid())
  name                String
  subjectName         String
  subjectCode         String
  phase               String
  grade               Int
  defaultTermCount    Int
  school              School?              @relation(fields: [schoolId], references: [id])
  schoolId            String?
  createdByRole       String
  assessmentTemplates AssessmentTemplate[]
  assessmentPlans     AssessmentPlan[]
  classGroups         ClassGroup[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model AssessmentTemplate {
  id                   String             @id @default(cuid())
  curriculumTemplate   CurriculumTemplate @relation(fields: [curriculumTemplateId], references: [id])
  curriculumTemplateId String
  taskName             String
  term                 String
  totalMark            Int
  rawWeight            Float
  sequence             Int
  type                 String?
  isPatComponent       Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model AssessmentDocument {
  id               String             @id @default(cuid())
  assessment       Assessment?        @relation(fields: [assessmentId], references: [id])
  assessmentId     String?
  assessmentPlan   AssessmentPlan?    @relation(fields: [assessmentPlanId], references: [id])
  assessmentPlanId String?
  thread           ModerationThread?  @relation(fields: [threadId], references: [id])
  threadId         String?
  label            String
  fileName         String
  mimeType         String
  fileUrl          String
  storageKey       String
  version          Int                @default(1)
  status           String             @default("Draft")
  uploadedByRole   String
  uploadedByName   String?
  uploadedAt       DateTime           @default(now())
  approvals        DocumentApproval[]
}

model DocumentApproval {
  id           String             @id @default(cuid())
  document     AssessmentDocument @relation(fields: [documentId], references: [id])
  documentId   String
  reviewerRole String
  reviewerName String?
  status       String             @default("Pending")
  notes        String?
  decidedAt    DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  school     School   @relation(fields: [schoolId], references: [id])
  schoolId   String
  entityType String
  entityId   String
  action     String
  actorRole  String
  actorName  String?
  metadata   Json?
  diff       Json?
  createdAt  DateTime @default(now())

  @@index([schoolId, createdAt])
}

model LearnerRegistration {
  id             String      @id @default(cuid())
  school         School      @relation(fields: [schoolId], references: [id])
  schoolId       String
  classGroup     ClassGroup? @relation(fields: [classGroupId], references: [id])
  classGroupId   String?
  status         String      @default("Draft")
  learnerData    Json
  guardianData   Json
  supportingDocs Json?
  student        Student?    @relation(fields: [studentId], references: [id])
  studentId      String?     @unique
  submittedAt    DateTime?
  decidedAt      DateTime?
  decisionNote   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model MarkSnapshot {
  id               String         @id @default(cuid())
  assessmentPlan   AssessmentPlan @relation(fields: [assessmentPlanId], references: [id])
  assessmentPlanId String
  student          Student        @relation(fields: [studentId], references: [id])
  studentId        String
  term             String
  sbaPercent       Float
  termPercent      Float
  level            Int
  capturedAt       DateTime       @default(now())

  @@unique([assessmentPlanId, studentId, term])
  @@index([assessmentPlanId, term])
}

model Timetable {
  id        String            @id @default(cuid())
  name      String
  school    School            @relation(fields: [schoolId], references: [id])
  schoolId  String
  year      Int
  term      String
  startDate DateTime
  endDate   DateTime
  status    String            @default("Draft")
  cycleType String            @default("Weekly")
  periods   TimetablePeriod[]
  slots     TimetableSlot[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([schoolId, year, term])
}

model TimetablePeriod {
  id           String          @id @default(cuid())
  timetable    Timetable       @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  timetableId  String
  name         String
  periodNumber Int
  startTime    String
  endTime      String
  dayOfWeek    Int
  slots        TimetableSlot[]
  createdAt    DateTime        @default(now())

  @@index([timetableId, dayOfWeek, periodNumber])
}

model TimetableSlot {
  id               String          @id @default(cuid())
  timetable        Timetable       @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  timetableId      String
  period           TimetablePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  periodId         String
  classGroup       ClassGroup      @relation(fields: [classGroupId], references: [id])
  classGroupId     String
  teacher          Teacher?        @relation(fields: [teacherId], references: [id])
  teacherId        String?
  room             String?
  notes            String?
  assessmentPlan   AssessmentPlan? @relation(fields: [assessmentPlanId], references: [id])
  assessmentPlanId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([timetableId, periodId])
  @@index([classGroupId])
  @@index([teacherId])
}

model LearnerComment {
  id           String     @id @default(cuid())
  student      Student    @relation(fields: [studentId], references: [id])
  studentId    String
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id])
  classGroupId String
  term         String
  year         Int
  commentType  String     @default("General") // General, Subject, Behaviour, Attendance
  comment      String
  authorRole   String
  authorName   String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([studentId, term, year])
  @@index([classGroupId, term])
}

model ReportCard {
  id                String     @id @default(cuid())
  student           Student    @relation(fields: [studentId], references: [id])
  studentId         String
  classGroup        ClassGroup @relation(fields: [classGroupId], references: [id])
  classGroupId      String
  term              String
  year              Int
  status            String     @default("Draft") // Draft, Published, Finalized
  overallGrade      String?
  overallPercentage Float?
  achievementLevel  Int?
  teacherComment    String?
  hodComment        String?
  principalComment  String?
  attendanceData    Json?
  conductGrade      String?
  effortGrade       String?
  generatedAt       DateTime?
  publishedAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([studentId, term, year])
  @@index([classGroupId, term, year])
  @@index([status])
}

// Teacher invitation for account linking
model TeacherInvitation {
  id         String    @id @default(cuid())
  teacher    Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId  String
  school     School    @relation(fields: [schoolId], references: [id])
  schoolId   String
  email      String // Email to send invitation to
  token      String    @unique // Secure token for accepting invitation
  roleKey    String    @default("teacher") // Role to assign upon acceptance
  status     String    @default("Pending") // Pending, Accepted, Expired, Revoked
  invitedBy  String? // User ID who sent the invitation
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([teacherId, email])
  @@index([token])
  @@index([email])
  @@index([status])
}

// ============================================
// Parent & Student User Authentication Models
// ============================================

// Links an AppUser to multiple ParentContacts (children)
model ParentUser {
  id        String          @id @default(cuid())
  user      AppUser         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String          @unique
  contacts  ParentContact[] @relation("ParentUserContacts")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

// Links an AppUser to a Student record for student portal access
model StudentUser {
  id        String   @id @default(cuid())
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @unique
  student   Student  @relation(fields: [studentId], references: [id])
  studentId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Parent invitation for account creation
model ParentInvitation {
  id              String        @id @default(cuid())
  parentContact   ParentContact @relation(fields: [parentContactId], references: [id], onDelete: Cascade)
  parentContactId String
  school          School        @relation(fields: [schoolId], references: [id])
  schoolId        String
  email           String
  token           String        @unique
  status          String        @default("Pending") // Pending, Accepted, Expired, Revoked
  invitedBy       String? // User ID who sent the invitation
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([token])
  @@index([email])
  @@index([status])
}

// Student invitation for account creation (controlled by school)
model StudentInvitation {
  id         String    @id @default(cuid())
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId  String
  school     School    @relation(fields: [schoolId], references: [id])
  schoolId   String
  email      String
  token      String    @unique
  status     String    @default("Pending") // Pending, Accepted, Expired, Revoked
  invitedBy  String? // User ID who sent the invitation
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([token])
  @@index([email])
  @@index([status])
}

// ============================================
// Merit/Demerit Behavior Tracking System
// ============================================

// Individual behavior incident (merit or demerit)
model BehaviorIncident {
  id           String    @id @default(cuid())
  student      Student   @relation(fields: [studentId], references: [id])
  studentId    String
  school       School    @relation(fields: [schoolId], references: [id])
  schoolId     String
  type         String // "Merit" | "Demerit"
  points       Int
  category     String // "Academic", "Conduct", "Service", "Sports", "Leadership", etc.
  description  String
  issuedBy     AppUser   @relation(fields: [issuedById], references: [id])
  issuedById   String
  date         DateTime  @default(now())
  term         String
  year         Int
  attachments  Json? // Optional attachments/evidence
  status       String    @default("Active") // Active, Revoked, Expired
  revokedAt    DateTime?
  revokedBy    String?
  revokeReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([studentId, term, year])
  @@index([schoolId, date])
  @@index([category])
}

// School-specific behavior policies and thresholds
model BehaviorPolicy {
  id            String   @id @default(cuid())
  school        School   @relation(fields: [schoolId], references: [id])
  schoolId      String
  name          String
  type          String // "Merit" | "Demerit"
  category      String
  description   String?
  defaultPoints Int
  thresholds    Json // Array of threshold rules with actions
  rewards       Json? // Rewards at merit thresholds
  consequences  Json? // Consequences at demerit thresholds
  isActive      Boolean  @default(true)
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([schoolId, type])
  @@index([category])
}

// Running balance of merits/demerits per student
model BehaviorBalance {
  id           String    @id @default(cuid())
  student      Student   @relation(fields: [studentId], references: [id])
  studentId    String    @unique
  meritTotal   Int       @default(0)
  demeritTotal Int       @default(0)
  netBalance   Int       @default(0)
  lastResetAt  DateTime?
  resetHistory Json? // Array of reset records
  updatedAt    DateTime  @updatedAt
}

// Threshold trigger records (when student crosses a threshold)
model BehaviorThresholdTrigger {
  id             String    @id @default(cuid())
  student        Student   @relation(fields: [studentId], references: [id])
  studentId      String
  school         School    @relation(fields: [schoolId], references: [id])
  schoolId       String
  type           String // "Merit" | "Demerit"
  thresholdValue Int
  thresholdName  String
  action         String // What action was triggered
  status         String    @default("Pending") // Pending, Actioned, Dismissed
  actionedBy     String?
  actionedAt     DateTime?
  notes          String?
  createdAt      DateTime  @default(now())

  @@index([studentId, type])
  @@index([schoolId, status])
}

// ============================================
// Communications & Messaging System
// ============================================

// Message thread (conversation)
model MessageThread {
  id            String    @id @default(cuid())
  school        School    @relation(fields: [schoolId], references: [id])
  schoolId      String
  type          String // "Direct", "Class", "School", "Announcement"
  subject       String?
  participants  Json // Array of participant IDs and types
  lastMessageAt DateTime?
  isArchived    Boolean   @default(false)
  messages      Message[]
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([schoolId, type])
  @@index([lastMessageAt])
}

// Individual message in a thread
model Message {
  id          String        @id @default(cuid())
  thread      MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId    String
  sender      AppUser       @relation(fields: [senderId], references: [id])
  senderId    String
  content     String        @db.Text
  attachments Json? // Array of attachment URLs
  readBy      Json          @default("[]") // Array of user IDs who have read
  isEdited    Boolean       @default(false)
  editedAt    DateTime?
  createdAt   DateTime      @default(now())

  @@index([threadId, createdAt])
}

// User notifications
model Notification {
  id        String    @id @default(cuid())
  user      AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  school    School?   @relation(fields: [schoolId], references: [id])
  schoolId  String?
  type      String // "behavior", "grade", "message", "announcement", "report", "system"
  title     String
  body      String
  data      Json? // Additional data for the notification
  actionUrl String? // URL to navigate to when clicked
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

// School announcements
model Announcement {
  id          String    @id @default(cuid())
  school      School    @relation(fields: [schoolId], references: [id])
  schoolId    String
  title       String
  content     String    @db.Text
  audience    Json // Who should see this (roles, grades, classes)
  priority    String    @default("Normal") // Low, Normal, High, Urgent
  publishAt   DateTime?
  expiresAt   DateTime?
  isPinned    Boolean   @default(false)
  attachments Json?
  createdBy   AppUser   @relation(fields: [createdById], references: [id])
  createdById String
  status      String    @default("Draft") // Draft, Published, Archived
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([schoolId, status])
  @@index([publishAt])
}

// ============================================
// Fees, Invoicing & Accounting System
// ============================================

// Fee structure definitions for the school
model FeeStructure {
  id          String        @id @default(cuid())
  school      School        @relation(fields: [schoolId], references: [id])
  schoolId    String
  name        String // e.g., "Grade 10 Annual Fees 2024"
  description String?
  grade       Int? // Optional: specific grade
  year        Int
  term        String? // Optional: specific term or "Annual"
  baseAmount  Float // Base fee amount in ZAR
  isActive    Boolean       @default(true)
  components  Json // Array of fee components: [{name, amount, optional, description}]
  discounts   FeeDiscount[]
  invoices    Invoice[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([schoolId, year])
  @@index([grade])
}

// Discount/Bursary definitions
model FeeDiscount {
  id            String       @id @default(cuid())
  feeStructure  FeeStructure @relation(fields: [feeStructureId], references: [id])
  feeStructureId String
  name          String // e.g., "Sibling Discount", "Merit Bursary"
  type          String // "Percentage" | "FixedAmount"
  value         Float // Percentage (e.g., 10) or fixed amount in ZAR
  criteria      Json? // Eligibility criteria
  maxUsage      Int? // Maximum number of students this can apply to
  currentUsage  Int          @default(0)
  validFrom     DateTime?
  validUntil    DateTime?
  isActive      Boolean      @default(true)
  applications  StudentDiscount[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

// Student-specific discount applications
model StudentDiscount {
  id          String      @id @default(cuid())
  student     Student     @relation(fields: [studentId], references: [id])
  studentId   String
  discount    FeeDiscount @relation(fields: [discountId], references: [id])
  discountId  String
  approvedBy  String? // User ID who approved
  approvedAt  DateTime?
  notes       String?
  status      String      @default("Pending") // Pending, Approved, Rejected, Expired
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([studentId, discountId])
}

// Invoice generation
model Invoice {
  id              String          @id @default(cuid())
  invoiceNumber   String          @unique // Auto-generated: INV-2024-001
  school          School          @relation(fields: [schoolId], references: [id])
  schoolId        String
  student         Student         @relation(fields: [studentId], references: [id])
  studentId       String
  feeStructure    FeeStructure?   @relation(fields: [feeStructureId], references: [id])
  feeStructureId  String?
  parentContact   ParentContact?  @relation(fields: [parentContactId], references: [id])
  parentContactId String?
  term            String
  year            Int
  subtotal        Float // Total before discounts
  discountAmount  Float           @default(0)
  taxAmount       Float           @default(0)
  totalAmount     Float // Final amount due
  paidAmount      Float           @default(0)
  balanceDue      Float // totalAmount - paidAmount
  status          String          @default("Draft") // Draft, Sent, Partially Paid, Paid, Overdue, Cancelled
  dueDate         DateTime
  sentAt          DateTime?
  lineItems       Json // Array of line items with amounts
  appliedDiscounts Json? // Discounts applied to this invoice
  notes           String?
  payments        Payment[]
  creditNotes     CreditNote[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([schoolId, status])
  @@index([studentId])
  @@index([dueDate])
}

// Payment records
model Payment {
  id              String    @id @default(cuid())
  paymentRef      String    @unique // Auto-generated: PAY-2024-001
  receiptNumber   String?   @unique // Auto-generated: REC-2024-001
  invoice         Invoice   @relation(fields: [invoiceId], references: [id])
  invoiceId       String
  amount          Float
  method          String // "EFT", "Card", "Cash", "ApplePay", "GooglePay", "PayFast", "Snapscan"
  gateway         String? // Payment gateway used
  gatewayRef      String? // External payment reference
  status          String    @default("Pending") // Pending, Processing, Completed, Failed, Refunded
  paidBy          String? // Name of person who made payment
  paidByContact   String? // Email or phone
  processedAt     DateTime?
  failureReason   String?
  metadata        Json? // Additional payment metadata
  receiptUrl      String? // URL to payment receipt
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([invoiceId])
  @@index([status])
}

// Account statement/ledger for reconciliation
model AccountLedger {
  id          String   @id @default(cuid())
  school      School   @relation(fields: [schoolId], references: [id])
  schoolId    String
  student     Student  @relation(fields: [studentId], references: [id])
  studentId   String
  type        String // "Invoice", "Payment", "Credit", "Adjustment", "WriteOff"
  description String
  debit       Float    @default(0)
  credit      Float    @default(0)
  balance     Float // Running balance
  reference   String? // Related invoice/payment ID
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([schoolId, studentId])
  @@index([createdAt])
}

// Credit notes for adjustments, refunds, or corrections
model CreditNote {
  id               String   @id @default(cuid())
  creditNoteNumber String   @unique // Auto-generated: CN-2024-001
  school           School   @relation(fields: [schoolId], references: [id])
  schoolId         String
  student          Student  @relation(fields: [studentId], references: [id])
  studentId        String
  invoice          Invoice? @relation(fields: [invoiceId], references: [id])
  invoiceId        String?
  amount           Float
  reason           String
  status           String   @default("Issued") // Issued, Voided
  issuedBy         String // userId of person who issued it
  voidedAt         DateTime?
  voidedBy         String?
  voidReason       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([schoolId, studentId])
  @@index([status])
}

// ============================================
// Homework/Assignment System
// ============================================

// Homework assignments (separate from assessments)
model Homework {
  id           String             @id @default(cuid())
  school       School             @relation(fields: [schoolId], references: [id])
  schoolId     String
  classGroup   ClassGroup         @relation(fields: [classGroupId], references: [id])
  classGroupId String
  teacher      Teacher            @relation(fields: [teacherId], references: [id])
  teacherId    String
  title        String
  description  String?            @db.Text
  subject      String
  dueDate      DateTime
  assignedDate DateTime           @default(now())
  attachments  Json? // Array of file URLs
  points       Int? // Optional points value
  status       String             @default("Active") // Active, Completed, Cancelled
  submissions  HomeworkSubmission[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([schoolId, dueDate])
  @@index([classGroupId])
  @@index([teacherId])
}

// Student homework submissions
model HomeworkSubmission {
  id           String    @id @default(cuid())
  homework     Homework  @relation(fields: [homeworkId], references: [id])
  homeworkId   String
  student      Student   @relation(fields: [studentId], references: [id])
  studentId    String
  status       String    @default("Pending") // Pending, Submitted, Late, Missing, Excused
  submittedAt  DateTime?
  attachments  Json? // Submitted files
  grade        String? // Optional grade: "Complete", "Incomplete", or numeric
  feedback     String?
  checkedBy    String? // Teacher who checked
  checkedAt    DateTime?
  parentNotified Boolean  @default(false) // Was parent notified if missing?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([homeworkId, studentId])
  @@index([homeworkId])
  @@index([studentId, status])
}

// ============================================
// Events Calendar System
// ============================================

// School events
model SchoolEvent {
  id           String    @id @default(cuid())
  school       School    @relation(fields: [schoolId], references: [id])
  schoolId     String
  title        String
  description  String?   @db.Text
  eventType    String // "Academic", "Sports", "Cultural", "Meeting", "Holiday", "Exam", "Other"
  startDate    DateTime
  endDate      DateTime?
  startTime    String? // HH:MM format
  endTime      String?
  location     String?
  isAllDay     Boolean   @default(false)
  isRecurring  Boolean   @default(false)
  recurrence   Json? // Recurrence rules
  audience     Json // Who can see: ["all"] or specific grades/classes
  color        String? // Calendar display color
  attachments  Json?
  reminders    Json? // Array of reminder configs
  createdBy    String
  status       String    @default("Active") // Active, Cancelled, Completed
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([schoolId, startDate])
  @@index([eventType])
}
